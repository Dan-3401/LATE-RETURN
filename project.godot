; Engine configuration file.
; Late Return / 迟归

config_version=5

[application]

config/name="迟归 Late Return"
config/description="2D pixel post-apocalyptic survival demo."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://art/ui/icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/systems/game_state.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
NoiseSystem="*res://scripts/systems/noise_system.gd"
SceneManager="*res://scripts/systems/scene_manager.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://scenes/ui/theme.tres"
theme/custom_font="res://fonts/fusion-pixel.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

